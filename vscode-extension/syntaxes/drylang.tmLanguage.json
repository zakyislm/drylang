{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DryLang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.drylang"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.drylang"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.drylang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolations"
            },
            {
              "match": "\\\\[nt\"'\\\\]",
              "name": "constant.character.escape.drylang"
            }
          ]
        },
        {
          "name": "string.quoted.single.drylang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#interpolations"
            },
            {
              "match": "\\\\[nt\"'\\\\]",
              "name": "constant.character.escape.drylang"
            }
          ]
        },
        {
          "name": "string.quoted.other.drylang",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "interpolations": {
      "patterns": [
        {
          "name": "meta.embedded.line.drylang",
          "begin": "\\$\\{",
          "end": "\\}",
          "captures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.drylang"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(fn|if|el|elif|lp|cns|rev|done|con|on|asn|awt|try|err|pv|use|mul|uni)\\b",
          "name": "keyword.control.drylang"
        },
        {
          "match": "\\b(t|f)\\b",
          "name": "constant.language.boolean.drylang"
        },
        {
          "match": "\\b(unknown)\\b",
          "name": "constant.language.null.drylang"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(len|get|add|num|str|abs|min|max|rnd|cap|low|trm|spl|j|mod|has|sort|pop|rm|key|val|ran|q|r|w|now|date|req|json|arg|env|cmd|dir|del|die|op|db|math|in|pt|cl)\\b",
          "name": "support.function.drylang"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+(?:,\\d+)?\\b",
          "name": "constant.numeric.drylang"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(->|\\+|-|\\*|/|%|!=|<|>|&|\\||!|=)",
          "name": "keyword.operator.drylang"
        }
      ]
    }
  },
  "scopeName": "source.drylang"
}
