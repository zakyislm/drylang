// test_07_builtins.y

pt(abs(0 - 10))
pt(math("pow", 2, 3))
pt(math("sqrt", 16))

d = date()
pt(d)

n = now()
pt(n)

// dir, env
e = env("PATH")
pt(len(e) > 0)

arr = [1, 2, 3]
pt(len(arr))

// push is not a builtin, but we can do it manually or test other array stuff
// dryLang doesn't have a direct push builtin, it seems.
arr = [1, 2, 3, 4]
pt(arr)

pop(arr)
pt(arr)

// json
j = json("{\"a\": 1}")
pt(j.a)

// op split
parts = spl("a,b,c", ",")
pt(parts)
