// test_05_funcs.y

fn add_num(a, b) {
    rev a + b
}
pt(add_num(10, 20))

// Recursion
fn fact(n) {
    if n <= 1 {
        rev 1
    }
    rev n * fact(n - 1)
}
pt(fact(5)) // 120

// Async functions
asn fn fetch_data() {
    // using builtin req could work, we just return a value for now
    rev "async_result"
}

// Top level await
res = fetch_data()
pt(res)
